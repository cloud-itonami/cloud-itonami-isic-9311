;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a facility-inspection robot performs physical
;; safety-condition checks at a sports facility (ISIC 9311), gated by the
;; Facility Safety Governor. Its physical work is patrolling the stand aisles
;; and concourse ramps, and proof-testing the steel anchor bolts that hold
;; spectator handrails / crush barriers.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-9311"
 :cases
 [{:id :stand-aisle-patrol
   :kind :transport
   :procedure "inspection robot drives one inspection leg up a stand aisle ramp carrying its sensor mast, and brakes to a stop at the checkpoint"
   :params {:mass-kg 55.0 :payload-kg 8.0 :distance-m 40.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 1.5 :drive-force-n 260.0 :crr 0.02
            :cog-height-m 0.45 :support-half-length-m 0.25 :payload-cog-height-m 1.30
            :max-time-s 1200.0}
   :sweep {:param :slope-deg :values [0.0 5.0 10.0 15.0 20.0]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: keep at least 30 % of the static stability margin under braking on a ramp, for sensor-mast sway and aisle-step edges"}
   :boundary {:lo 0.0 :hi 30.0}}
  {:id :handrail-anchor-bolt-proof
   :kind :material
   :procedure "robot proof-tests a sampled M12 handrail anchor bolt in tension and records the 0.2 % offset yield load, for each bolt property class found on site"
   :params {:length-m 0.10 :area-m2 8.43e-5 :youngs-modulus-pa 205.0e9
            :hardening-pa 1.0e9 :density-kg-m3 7850.0 :max-force-n 65000.0}
   :sweep {:param :yield-stress-pa :values [240.0e6 300.0e6 480.0e6 640.0e6]}
   :quantity :yield-force-n
   :limit {:min 15000.0 :basis "estimate: per-anchor tensile demand of a handrail post (line load x post spacing x lever arm / bolt spacing, with a load factor); 84.3 mm2 is the ISO 898-1 tensile stress area of M12 and 240/300/480/640 MPa are the ISO 898-1 nominal yield strengths of classes 4.6/5.6/6.8/8.8"}}]}
